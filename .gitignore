# ── Secrets ──────────────────────────────────────────────────────────────────
.env
*.env.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
web/dist/
.vite/
web/coverage/
web/playwright-report/
web/test-results/
*.tsbuildinfo

# ── Codegen ──────────────────────────────────────────────────────────────────
# openapi.json is an intermediate build artifact regenerated by
# scripts/codegen-types. The committed source-of-truth for the frontend is
# web/src/lib/api/_generated.ts (re-generated from openapi.json).
web/openapi.json

# ── Docker ───────────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── Libraries config (user-specific, not committed) ──────────────────────────
libraries.conf

# ── Test fixtures (generated output) ─────────────────────────────────────────
api/tests/fixtures/generated/
api/tests/fixtures/_notes/settings/librarian-sessions/
# Handwriting/transcription pass output — regenerated by test_handwriting each
# run with a fresh `transcribed_at`; committing them churned the tree endlessly.
api/tests/fixtures/_notes/inbox/*-transcript.md

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
# neovim
*.un~
Session.vim
.netrwhist
.claire/

# Container-side artifacts that can appear in the working tree
api/host_root/

# Local databases — the real one lives in a Docker named volume, but a stray
# copy in the tree must never be committed (it contains vault content).
*.db
*.sqlite3

# Logs
*.log

# Coverage reports (see ./scripts/coverage)
htmlcov/
api/htmlcov/
.coverage
api/.coverage
coverage.json

# ── Native macOS build ────────────────────────────────────────────────────────
# Everything the desktop build produces or downloads. The sources
# (desktop/src-tauri/{src,Cargo.toml,tauri.conf.json,capabilities,icons},
# desktop/backend_main.py, scripts/build-desktop.sh) ARE tracked; these are
# outputs, and they are large — a built .app is ~450MB.
.build-venv/
desktop/node_modules/
desktop/build/
desktop/dist/
desktop/.tools/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Staged bundle payload: the frozen backend, the model, the SPA copy, rg.
desktop/src-tauri/resources/

# Local Archive (org edition) working data
.archive/


# Governance backups (scripts/governance.sh); may hold password hashes
backups/
