# Pillar-43 — environment configuration
# Copy this file to .env and fill in your values,
# or run ./setup.sh to be guided through it interactively.

# ── Models ───────────────────────────────────────────────────────────────────

# Ollama is the only model provider. OLLAMA_URL is where the backend reaches it
# (under Docker, the host's Ollama is host.docker.internal); no setting in the
# app can point it elsewhere.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

# Local vision model for handwriting transcription and image captions. Must
# already be pulled in Ollama (`ollama pull qwen2.5vl:7b`).
# VISION_MODEL=qwen2.5vl:7b

# ── Vault Paths ──────────────────────────────────────────────────────────────

# Read-only library archive (your reference library: PDFs, books, notes)
LIBRARY_ROOT=/Users/you/Documents/library

# Read-write working notes (Pillar-43 creates and edits files here)
NOTES_PATH=/Users/you/Documents/pillar43-notes

# Read-write AI output (catalog database, daily dispatches, generated files)
GENERATED_PATH=/Users/you/Documents/pillar43-generated

# Extra read-only libraries — use libraries.conf instead of an env var.
# Each library can be any path anywhere on your filesystem.
# To add libraries: edit libraries.conf, then run scripts/gen-libraries-override.sh
# Then restart: docker compose up --build -d

# ── API host port (optional) ─────────────────────────────────────────────────
# The host port the API binds to; the container port is always 8000. Defaults
# to 8002 because 8000/8001 are commonly held by other local projects. Change
# it here if 8002 is taken.
# API_PORT=8002

# The host port the web UI binds to.
# WEB_PORT=5173

# Which env file the CONTAINERS load. Leave unset for the default `.env`.
# PILLAR43_ENV_FILE=.env

# The four above exist so a SECOND Pillar-43 can run on the same machine (see
# DEV_MANUAL.md → "Two-Pillar-43 setup").
#
# PILLAR43_ENV_FILE is the one that is easy to miss, and getting it wrong fails
# silently. `--env-file` controls ${VAR} substitution in docker-compose.yml —
# ports and volume paths. `env_file:` inside each service controls what is
# injected INTO the container — API keys, provider settings.
# They are different mechanisms. Set only the first and your second instance
# gets its own vault and ports but reads the FIRST instance's provider
# settings. Nothing errors. So a second instance sets both:
#
#   # in .env.bob
#   PILLAR43_ENV_FILE=.env.bob
#   docker compose -p pillar43-bob --env-file .env.bob up --build -d
#
# The web UI needs no port configuration: it talks to its own API same-origin
# through nginx, so each instance is self-contained.

# OAuth redirect base for cloud sources (Drive/Dropbox). Must be
# browser-reachable and registered in the provider's app config, so it carries
# the HOST port — keep it in step with API_PORT above.
# API_BASE_URL=http://127.0.0.1:8002

# ── Host-header allowlist (advanced) ─────────────────────────────────────────
# TrustedHostMiddleware blocks DNS-rebinding. Loopback + the "api" Docker
# service name are allowed by default (the latter is set in docker-compose.yml,
# needed by the web proxy and worker). Only set this to extend the allowlist for
# a reverse proxy or custom hostname — comma-separated bare hostnames, no port.
# ALLOWED_HOSTS=pillar43.example.com,api
