#!/usr/bin/env bash
# Run backend tests for files changed in the current commit.
#
# Step 5.2 of the AI Agentic Coding plan, "smarter wrapper" branch.
# Goal: <30s pre-commit overhead for typical commits, vs ~36s full sweep.
#
# Strategy: derive a -k filter from the staged changes.
#   - changed `api/tests/test_X.py` → include `test_X` in the filter
#   - changed `api/<area>/<name>.py` → include `<name>` in the filter
#     (matches `test_<name>.py` AND any test referencing the symbol)
# If no .py changes are staged, exit 0 immediately (cheap).
#
# Fallback: if the derived filter would be empty but .py files changed,
# fall back to the full suite. Better safe than gappy.
#
# Pass --all to force the full sweep (useful in CI).

set -euo pipefail

cd "$(dirname "$0")/.."  # to src/

if [[ "${1-}" == "--all" ]]; then
    exec ./scripts/test-api tests/
fi

# Use the index (staged changes); fall back to working tree if unstaged.
changed=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^api/.+\.py$' || true)
if [[ -z "$changed" ]]; then
    changed=$(git diff --name-only --diff-filter=ACMR | grep -E '^api/.+\.py$' || true)
fi

if [[ -z "$changed" ]]; then
    echo "[test-api-changed] no Python changes; skipping"
    exit 0
fi

# Derive keywords. Test files contribute their full name; source files
# contribute their basename (test files usually mirror the source name).
keywords=()
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    base=$(basename "$f" .py)
    if [[ "$f" == api/tests/* ]]; then
        keywords+=("$base")
    else
        # api/foo/bar.py → keyword "bar" (matches test_bar.py + any test
        # whose name contains "bar"). Generic enough to catch most paths
        # without over-broadening.
        keywords+=("$base")
    fi
done <<< "$changed"

if [[ ${#keywords[@]} -eq 0 ]]; then
    echo "[test-api-changed] couldn't derive keywords; falling back to full suite"
    exec ./scripts/test-api tests/
fi

# Build the -k expression: "kw1 or kw2 or kw3"
filter=""
for k in "${keywords[@]}"; do
    if [[ -z "$filter" ]]; then
        filter="$k"
    else
        filter="$filter or $k"
    fi
done

echo "[test-api-changed] keywords: $filter"
exec ./scripts/test-api -k "$filter"
